# Copia este archivo a .env (no lo subas a GitHub). Todas las variables tienen valor por omisión.
DATABASE_URL=sqlite:///./novarent.db
ENTORNO=desarrollo
CARGAR_DATOS_DEMO=true
PERMITIR_RELOJ_SIMULADO=false
# EVIDENCIAS_DIR=./evidencias     # vacío = fotos solo en memoria

# docker compose
POSTGRES_USER=novarent
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=novarent

# Parámetros de negocio (BRD / ACT-F03). Cambian por configuración, sin tocar código.
TOLERANCIA_RETRASO_MIN=29
TARIFA_KM_EXCEDENTE=3
UMBRAL_COMBUSTIBLE_OCTAVOS=1
TARIFA_POR_OCTAVO=50
LIMITE_EXTENSION_AGENTE_HORAS=48
ANTICIPACION_EXTENSION_HORAS=2
HORAS_CANCELACION_GRATUITA=24
HORAS_NO_SHOW=2
DIAS_HABILES_LIBERACION_DEPOSITO=5
DIAS_PENALIZACION=1
